# Copy to .env.local and fill in. Never commit real values.

# Vercel Daily News API (server-only)
VERCEL_DAILY_API_URL=https://vercel-daily-news-api.vercel.app/api
# Deployment Protection bypass token, sent as the x-vercel-protection-bypass header
VERCEL_DAILY_API_BYPASS_TOKEN=

# Secret (32+ chars) used to sign the short-lived subscription proof cookie,
# so the proxy doesn't re-verify subscriptions with the API on every request.
# Generate with: openssl rand -base64 48
SUBSCRIPTION_PROOF_SECRET=
